{
  "collectionName": "components_media_video_links",
  "info": {
    "displayName": "Видео-ссылка",
    "description": "Видео-ссылка (YouTube/VK/RuTube/Другое) или загрузка видео файла"
  },
  "attributes": {
    "provider": {
      "type": "enumeration",
      "enum": ["YouTube", "RuTube", "VK", "Другое"],
      "default": "Другое"
    },
    "url": {
      "type": "string",
      "required": false
    },
    "open_in_vk": {
      "type": "boolean",
      "default": false
    },
    "video_file": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    }
  }
}
