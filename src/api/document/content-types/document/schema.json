{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Документы / Documents",
    "description": "Общий репозиторий документов"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title" },
    "category": {
      "type": "enumeration",
      "enum": ["Реестр", "Метод. Рекомендации"],
      "required": true
    },
    "description": { "type": "text", "required": false },
    "files": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["files", "images"]
    },
    "attachments": {
      "type": "component",
      "repeatable": false,
      "component": "document.attachments"
    }
  }
}
