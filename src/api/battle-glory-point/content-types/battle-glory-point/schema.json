{
  "kind": "collectionType",
  "collectionName": "battle_glory_points",
  "info": {
    "singularName": "battle-glory-point",
    "pluralName": "battle-glory-points",
    "displayName": "Карта Боевой Славы - Точки",
    "description": "Памятники, мемориалы, мемориальные доски и воинские захоронения"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "point_type": {
      "type": "enumeration",
      "enum": [
        "памятник/мемориал",
        "мемориальная доска",
        "воинское захоронение"
      ],
      "required": true
    },
    "municipality": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string"
    },
    "formatted_address": {
      "type": "text"
    },
    "coordinates": {
      "type": "customField",
      "customField": "plugin::strapi-location-picker.location-picker",
      "options": {
        "info": true
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "preview_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "region": {
      "type": "string"
    },
    "object_name": {
      "type": "string"
    },
    "geocoding_status": {
      "type": "string"
    },
    "original_number": {
      "type": "string"
    }
  }
}

