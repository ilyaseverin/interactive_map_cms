{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Страницы (тематические разделы)",
    "description": "Статические страницы тематических разделов"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "unique": true },
    "body": { "type": "richtext" },
    "attachments": { "type": "component", "repeatable": true, "component": "media.document" },
    "links": { "type": "component", "repeatable": true, "component": "meta.link" },
    "category": {
      "type": "enumeration",
      "enum": [
        "Антимонопольный комплекс",
        "Антикоррупционная деятельность",
        "Противодействие терроризму",
        "Антинаркотическая кампания"
      ]
    }
  }
}
